# Copy this file to .env inside backend/ and fill in real values.
# This file contains NAMES and safe placeholders only. Never put real
# secrets in this file, and never commit a real .env file.
# The server loads .env from the backend/ working directory.

# Port the API listens on (default: 5000)
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/animal-lifeline

# JWT secrets (use long, random strings in production)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Frontend origin allowed by CORS (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Set to "production" in production; anything else keeps cookies non-secure
NODE_ENV=development

# Razorpay (test mode keys for development; live keys only in production)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# A DIFFERENT secret from the key secret, from Razorpay Dashboard ->
# Settings -> Webhooks, for the donation webhook signature check
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloudinary, for NGO/vet document uploads and photos
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
